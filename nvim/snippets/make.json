{
  "Makefile for cpp": {
    "prefix": "cpp",
    "body": [
      "# Makefile (c/cpp)",
      "#",
      "# Run options (all optional, combinable):",
      "#   make run args=\"--verbose foo\"",
      "#   make run in=input.txt out=output.txt err=errors.txt",
      "#   make run args=\"-n 10\" in=data.txt out=result.txt err=run.log",
      "",
      "TARGET   := ${1:main}",
      "INPUT    := ${2:input}",
      "SRCS     := \\$(wildcard *.cpp *.c)",
      "CXXFLAGS := -g -Wall -Wextra -O2 -std=c++17",
      "",
      "_ARGS := \\$(if \\$(args), \\$(args))",
      "_IN   := \\$(if \\$(INPUT), < \\$(INPUT))",
      "_OUT  := \\$(if \\$(out),   > \\$(out))",
      "_ERR  := \\$(if \\$(err),   2> \\$(err), 2>&1)",
      "",
      ".PHONY: build run clean rebuild",
      "",
      "build:",
      "\t@echo \"[build] \\$(TARGET)\"",
      "\tg++ \\$(CXXFLAGS) \\$(SRCS) -o \\$(TARGET)",
      "",
      "run: build",
      "\t@echo \"[run] ./\\$(TARGET)\\$(if \\$(args), \\$(args))\\$(if \\$(in), < \\$(in))\\$(if \\$(out), > \\$(out))\\$(if \\$(err), 2> \\$(err))\"",
      "\t./\\$(TARGET) \\$(_ARGS) \\$(_IN) \\$(_OUT) \\$(_ERR)",
      "",
      "clean:",
      "\t@echo \"[clean]\"",
      "\trm -f \\$(TARGET) *.o",
      "",
      "rebuild: clean build"
    ],
    "description": "Makefile template for cpp"
  },
  "Makefile for tla": {
    "prefix": "tla",
    "body": [
      "# Makefile (tla)",
      "#",
      "# Targets:",
      "#   make build                    — SANY syntax check",
      "#   make run                      — TLC model checker (needs matching .cfg)",
      "#   make run args=\"-simulate\"     — pass extra flags to TLC",
      "#   make run out=f.txt            — capture TLC output to file",
      "#   make run err=f.txt            — capture TLC errors/warnings to file",
      "#",
      "# Note: TLA+ tools read .tla/.cfg directly; in= (stdin) is not applicable.",
      "",
      "MODULE   := \\$(basename \\$(wildcard *.tla))",
      "TLA2JAR  := ~/.local/share/tla2tools/tla2tools.jar",
      "JAVA     := java",
      "TLCFLAGS := -XX:+UseParallelGC -Xmx2g",
      "",
      "_ARGS := \\$(if \\$(args), \\$(args))",
      "_OUT  := \\$(if \\$(out),  > \\$(out))",
      "_ERR  := \\$(if \\$(err),  2> \\$(err), 2>&1)",
      "",
      ".PHONY: build run clean rebuild",
      "",
      "build:",
      "\t@echo \"[sany] \\$(MODULE).tla\"",
      "\t\\$(JAVA) -cp \\$(TLA2JAR) tla2sany.SANY \\$(MODULE).tla \\$(_OUT) \\$(_ERR)",
      "",
      "run:",
      "\t@echo \"[tlc] \\$(MODULE).tla\\$(if \\$(args), \\$(args))\\$(if \\$(out), > \\$(out))\\$(if \\$(err), 2> \\$(err))\"",
      "\t\\$(JAVA) \\$(TLCFLAGS) -cp \\$(TLA2JAR) tlc2.TLC \\",
      "\t    -workers auto \\$(MODULE).tla -config \\$(MODULE).cfg \\$(_ARGS) \\$(_OUT) \\$(_ERR)",
      "",
      "clean:",
      "\t@echo \"[clean]\"",
      "\trm -rf states/ *.out",
      "",
      "rebuild: clean build"
    ],
    "description": "Makefile template for tla"
  },
  "Makefile for go": {
    "prefix": "go",
    "body": [
      "# Makefile (go)",
      "#",
      "# Run options (all optional, combinable):",
      "#   make run args=\"--port 8080\"",
      "#   make run in=input.txt out=output.txt err=errors.txt",
      "#   make run args=\"-v\" in=data.txt out=result.txt err=run.log",
      "",
      "TARGET := ${1:main}",
      "PKG    := .",
      "",
      "_ARGS := \\$(if \\$(args), \\$(args))",
      "_IN   := \\$(if \\$(in),   < \\$(in))",
      "_OUT  := \\$(if \\$(out),  > \\$(out))",
      "_ERR  := \\$(if \\$(err),  2> \\$(err), 2>&1)",
      "",
      ".PHONY: build run clean rebuild",
      "",
      "build:",
      "\t@echo \"[build] \\$(TARGET)\"",
      "\tgo build -o \\$(TARGET) \\$(PKG)",
      "",
      "run:",
      "\t@echo \"[run] go run \\$(PKG)\\$(if \\$(args), \\$(args))\\$(if \\$(in), < \\$(in))\\$(if \\$(out), > \\$(out))\\$(if \\$(err), 2> \\$(err))\"",
      "\tgo run \\$(PKG) \\$(_ARGS) \\$(_IN) \\$(_OUT) \\$(_ERR)",
      "",
      "clean:",
      "\t@echo \"[clean]\"",
      "\trm -f \\$(TARGET)",
      "\tgo clean",
      "",
      "rebuild: clean build"
    ],
    "description": "Makefile template for go"
  },
  "Makefile for rust": {
    "prefix": "rust",
    "body": [
      "# Makefile (rust)",
      "#",
      "# Run options (all optional, combinable):",
      "#   make run args=\"--port 8080\"",
      "#   make run in=input.txt out=output.txt err=errors.txt",
      "#   make run args=\"-v\" in=data.txt out=result.txt err=run.log",
      "#",
      "# Note: args are passed to the binary via `cargo run -- <args>`.",
      "",
      "_ARGS := \\$(if \\$(args), -- \\$(args))",
      "_IN   := \\$(if \\$(in),   < \\$(in))",
      "_OUT  := \\$(if \\$(out),  > \\$(out))",
      "_ERR  := \\$(if \\$(err),  2> \\$(err), 2>&1)",
      "",
      ".PHONY: build run clean rebuild",
      "",
      "build:",
      "\t@echo \"[build]\"",
      "\tcargo build",
      "",
      "run:",
      "\t@echo \"[run] cargo run\\$(if \\$(args), -- \\$(args))\\$(if \\$(in), < \\$(in))\\$(if \\$(out), > \\$(out))\\$(if \\$(err), 2> \\$(err))\"",
      "\tcargo run \\$(_ARGS) \\$(_IN) \\$(_OUT) \\$(_ERR)",
      "",
      "clean:",
      "\t@echo \"[clean]\"",
      "\tcargo clean",
      "",
      "rebuild: clean build"
    ],
    "description": "Makefile template for rust"
  }
}
